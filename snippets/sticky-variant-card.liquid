{% comment %}
  Renders a single variant card for the sticky bar.

  Accepts:
  - variant: {Object} Product variant object
  - product: {Object} Product object

  Usage:
  {% render 'sticky-variant-card', variant: variant, product: product %}
{% endcomment %}

<div class="sticky-bar__card{% if variant.available == false %} sticky-bar__card--sold-out{% endif %}">
  <div class="sticky-bar__card-info">
    {%- if variant.image -%}
      <div class="sticky-bar__card-image">
        {{
          variant.image
          | image_url: width: 100
          | image_tag: loading: 'lazy', widths: '50, 80, 100', alt: variant.title
        }}
      </div>
    {%- endif -%}
    <div class="sticky-bar__card-details">
      <span class="sticky-bar__card-title">{{ variant.title }}</span>
      <span class="sticky-bar__card-price">{{ variant.price | money }}</span>
    </div>
  </div>
  {%- if variant.available -%}
    <form action="/cart/add" method="post">
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="sticky-bar__buy-btn">
        BUY<br>NOW
      </button>
    </form>
  {%- else -%}
    <div class="sticky-bar__buy-btn sticky-bar__buy-btn--disabled">
      SOLD<br>OUT
    </div>
  {%- endif -%}
</div>
