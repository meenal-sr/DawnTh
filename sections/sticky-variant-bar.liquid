{% comment %}
  Sticky variant bar — fixed to bottom of product page.
  Shows all variants with image, title, price, and Buy Now button.
{% endcomment %}

{%- if product.variants.size > 1 -%}
  <div id="StickyVariantBar" class="sticky-bar sticky-bar--hidden">
    <div class="sticky-bar__inner page-width">
      {%- for variant in product.variants -%}
        <div class="sticky-bar__card-wrapper{% if forloop.index > 2 %} sticky-bar__card-wrapper--desktop-only{% endif %}">
          {% render 'sticky-variant-card', variant: variant, product: product %}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(240, 240, 240, 1) 20%);
      padding: 1.2rem 0 1rem;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .sticky-bar--hidden {
      transform: translateY(100%);
      opacity: 0;
      pointer-events: none;
    }

    .sticky-bar__inner {
      display: flex;
      justify-content: center;
      gap: 1.2rem;
    
    }

    .sticky-bar__card {
      display: flex;
      align-items: stretch;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      border: 1.5px solid #000;
      flex: 1 0 260px;
    
    }

    .sticky-bar__card--sold-out {
      opacity: 0.5;
    }

    .sticky-bar__card-info {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.6rem 1rem;
      flex: 1;
      min-width: 0;
    }

    .sticky-bar__card-image {
      width: 80px;
      flex-shrink: 0;
    }

    .sticky-bar__card-image .responsive-image__image {
      object-fit: contain !important;
    }

    .sticky-bar__card-details {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }

    .sticky-bar__card-title {
      font-size: 1.5rem;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sticky-bar__card-price {
      font-size: 1.8rem;
      font-weight: 700;
      color: #000;
    }

    .sticky-bar__buy-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #333;
      color: #fff;
      border: none;
      padding: 0 1.5rem;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      cursor: pointer;
      text-align: center;
      line-height: 1.3;
      flex-shrink: 0;
    }

    .sticky-bar__buy-btn:hover {
      background: #fff;
      color: #000;
    }

    .sticky-bar__buy-btn--disabled {
      cursor: not-allowed;
      background: #999;
    }

    .sticky-bar__card form {
      display: flex;
      margin: 0;
    }

    

    @media (max-width: 1023px) {
      .sticky-bar__card-wrapper--desktop-only {
        display: none;
      }

      .sticky-bar {
        padding: 0.8rem 0 0.6rem;
      }

      .sticky-bar__inner {
        gap: 0.8rem;
        
      }

      .sticky-bar__buy-btn,
      .sticky-bar__buy-btn--disabled {
        display: none;
      }

      .sticky-bar__card {
        cursor: pointer;
        flex: 1 1 0;
        max-width: 190px;
        border-radius: 8px;
        border: 1px solid #ccc;
      }

      .sticky-bar__card-info {
        display: flex;
        
        gap: 2.6rem
      }

      .sticky-bar__card-image {
        width: 50px;
      }

      .sticky-bar__card-title {
        font-size: 1.1rem;
        white-space: nowrap;
      }

      .sticky-bar__card-price {
        font-size: 1.2rem;
      }
    }
  </style>

  <script>
    (function() {
      const bar = document.getElementById('StickyVariantBar');
      const productInfo = document.querySelector('product-info');
      if (!bar || !productInfo) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          bar.classList.toggle('sticky-bar--hidden', entry.isIntersecting);
        });
      });

      observer.observe(productInfo);

      if (window.matchMedia('(max-width: 1023px)').matches) {
        bar.querySelectorAll('.sticky-bar__card').forEach((card) => {
          card.addEventListener('click', () => {
            const form = card.querySelector('form');
            if (form) form.submit();
          });
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky Variant Bar",
  "class": "sticky-variant-bar-section",
  "settings": [],
  "templates": ["product"]
}
{% endschema %}
