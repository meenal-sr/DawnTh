{% comment %}
  Sticky variant bar — fixed to bottom of product page.
  Shows all variants with image, title, price, and Buy Now button.
{% endcomment %}

{%- if product.variants.size > 1 -%}
  <div id="StickyVariantBar" class="sticky-bar sticky-bar--hidden">
    <div class="sticky-bar__inner page-width">
      {%- for variant in product.variants -%}
        {% render 'sticky-variant-card', variant: variant, product: product %}
      {%- endfor -%}
    </div>
  </div>

  <style>
    .sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(240, 240, 240, 1) 20%);
      padding: 1.2rem 0 1rem;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .sticky-bar--hidden {
      transform: translateY(100%);
      opacity: 0;
      pointer-events: none;
    }

    .sticky-bar__inner {
      display: flex;
      justify-content: center;
      gap: 1.2rem;
    }

    .sticky-bar__card {
      display: flex;
      align-items: stretch;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      flex: 1;
      max-width: 340px;
      min-width: 0;
    }

    .sticky-bar__card--sold-out {
      opacity: 0.5;
    }

    .sticky-bar__card-info {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.6rem 1rem;
      flex: 1;
      min-width: 0;
    }

    .sticky-bar__card-image {
      width: 60px;
      height: 60px;
      flex-shrink: 0;
    }

    .sticky-bar__card-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .sticky-bar__card-details {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }

    .sticky-bar__card-title {
      font-size: 1.3rem;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sticky-bar__card-price {
      font-size: 1.5rem;
      font-weight: 700;
      color: #000;
    }

    .sticky-bar__buy-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #333;
      color: #fff;
      border: none;
      padding: 0 1.5rem;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      cursor: pointer;
      text-align: center;
      line-height: 1.3;
      flex-shrink: 0;
    }

    .sticky-bar__buy-btn:hover {
      background: #000;
    }

    .sticky-bar__buy-btn--disabled {
      cursor: not-allowed;
      background: #999;
    }

    .sticky-bar__card form {
      display: flex;
      margin: 0;
    }
  </style>

  <script>
    (function() {
      const bar = document.getElementById('StickyVariantBar');
      const productInfo = document.querySelector('product-info');
      if (!bar || !productInfo) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          bar.classList.toggle('sticky-bar--hidden', entry.isIntersecting);
        });
      });

      observer.observe(productInfo);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky Variant Bar",
  "class": "sticky-variant-bar-section",
  "settings": [],
  "templates": ["product"]
}
{% endschema %}
