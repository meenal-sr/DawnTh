<div class="example-heading__blocks">
  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      <h3
        class="example-heading__block-heading {{ block.settings.heading_size }}"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.heading }}
      </h3>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Example heading section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "My heading-only section"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 5,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Your rich text heading here"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2",  "label": "Medium" },
            { "value": "h1",  "label": "Large" },
            { "value": "h0",  "label": "Extra large" }
          ],
          "default": "h1",
          "label": "Heading size"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Example heading section",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Preset heading"
          }
        }
      ]
    }
  ]
}
{% endschema %}