{% layout 'theme' %}

<div data-spec-list="spec-list"></div>





{% schema %}
{
  "name": "product-specs",

  "blocks": [   
    {
      "name": "product-blocks",
      "type": "product-blocks",
      "settings": [
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title"
        },
        {
          "type": "richtext",
          "id": "product_des",
          "label": "Product desc"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "product-specs"
    }
  ]
}
{% endschema %}
